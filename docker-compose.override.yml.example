# docker-compose.override.yml.example
#
# Kopiere diese Datei nach docker-compose.override.yml und passe sie an.
# docker-compose.override.yml wird automatisch von docker compose geladen
# und ist in .gitignore (keine Credentials im Repo).
#
# Ohne override.yml läuft der Service im stdio-Modus (Default, für docker run -i).
# Mit override.yml läuft er im HTTP-Modus (siehe command unten).
#
#   cp docker-compose.override.yml.example docker-compose.override.yml
#   docker compose up --build -d
#   curl http://localhost:8080/healthz

services:
  fritzbox-mcp:
    stdin_open: false
    tty: false
    ports:
      - "${MCP_PORT:-8080}:${MCP_PORT:-8080}"
    command: ["--transport", "streamable-http", "--port", "${MCP_PORT:-8080}", "--host", "0.0.0.0"]
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:8080/healthz | grep -q 'ok'"]
      interval: 5s
      timeout: 3s
      retries: 10
      start_period: 3s
    # --- Optionale Anpassungen (ein-/auskommentieren) ---
    # Entwicklung: debug-Flag (command oben um "--debug" ergänzen)
    environment:
      - FRITZ_TLS=false   # TLS aus für lokale LAN-Fritzbox; für Prod auf true setzen
    # Produktion: restart, logging, Ressourcen-Limits
    # restart: unless-stopped
    # logging:
    #   driver: json-file
    #   options:
    #     max-size: "10m"
    #     max-file: "3"
    # deploy:
    #   resources:
    #     limits:
    #       memory: 256M
    #       cpus: "0.5"